# ──────────────────────────────────────────────────────
# REALITY WEB ECOSYSTEM — ENVIRONMENT VARIABLES
# ──────────────────────────────────────────────────────
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# ──────────────────────────────────────────────────────

# == Discord OAuth2 ==
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback
DISCORD_GUILD_ID=your_discord_guild_id

# == JWT ==
JWT_SECRET=your-256-bit-jwt-secret-change-me-in-production
JWT_EXPIRES_IN=24h

# == Token Encryption (AES-256-GCM) ==
TOKEN_ENCRYPTION_KEY=your-32-character-encryption-key-here!!

# == Database (qb-core MariaDB/MySQL) ==
DATABASE_URL=mysql://user:password@localhost:3306/qbcore

# == Server ==
PORT=3001
NODE_ENV=development

# == CORS ==
CLIENT_ORIGIN=http://localhost:3000

# == Redis (optional, for session store) ==
REDIS_URL=redis://localhost:6379

# == Discord Bot Token (for role assignment) ==
DISCORD_BOT_TOKEN=your_discord_bot_token

# == Discord Webhook (for MDT warrant alerts) ==
DISCORD_WEBHOOK_WARRANTS=your_discord_webhook_url
